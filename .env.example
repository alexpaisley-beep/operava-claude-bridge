# ===== Operava Claude Bridge configuration =====
# Copy to .env for local development (export into your shell), or set these as
# Railway variables in production. NEVER commit real values.

# --- Core ---
NODE_ENV=development
LOG_LEVEL=info
PORT=8080
# Public HTTPS origin of the API service. REQUIRED in production when OAuth is
# enabled (ChatGPT connectors). e.g. https://claude-bridge-api.up.railway.app
PUBLIC_BASE_URL=http://localhost:8080

# --- Database (durable state; Railway Postgres plugin provides this) ---
DATABASE_URL=postgres://postgres@127.0.0.1:5432/claude_bridge
DATABASE_SSL=false
DATABASE_POOL_SIZE=10

# --- Authentication for MCP callers ---
# Static bearer tokens for API clients (comma separated, min 24 chars each in
# production). ChatGPT custom connectors use the built-in OAuth flow instead.
BRIDGE_API_TOKENS=
# Built-in OAuth 2.1 authorization server (required for ChatGPT connectors).
OAUTH_ENABLED=true
# The human operator secret entered on the OAuth consent page (min 16 chars).
BRIDGE_OPERATOR_KEY=
OAUTH_ACCESS_TOKEN_TTL_SECONDS=28800
OAUTH_REFRESH_TOKEN_TTL_SECONDS=2592000

# --- GitHub (server-side only; never exposed through MCP) ---
# Fine-grained PAT or GitHub App installation token with: contents read/write,
# pull requests read/write, checks read — on the allowlisted repositories only.
GITHUB_TOKEN=
# GITHUB_API_BASE=https://api.github.com
# Register every repository GITHUB_TOKEN can reach into the registry at boot
# (additive only: existing entries — including disabled ones — are untouched).
# Set to false to manage the allowlist purely by hand.
# GITHUB_AUTO_REGISTER_REPOS=true

# --- Claude (server-side only; never exposed through MCP) ---
# Anthropic API key used by the worker's Claude Code executions (API billing).
ANTHROPIC_API_KEY=
# 'agent-sdk' in production. 'mock' is for tests/dev only and refuses to start
# in production.
CLAUDE_RUNNER=agent-sdk
# Allow Claude to use WebFetch/WebSearch during engineering tasks.
CLAUDE_ALLOW_NETWORK_TOOLS=false

# --- Model control (aliases callers may request; server-side allowlist) ---
CLAUDE_MODEL_DEFAULT=claude-sonnet-5
CLAUDE_MODEL_FAST=claude-haiku-4-5
CLAUDE_MODEL_STRONG=claude-opus-5
CLAUDE_MODEL_STRONGEST=claude-opus-5
# Extra explicit model IDs callers may request, comma separated.
CLAUDE_MODEL_EXTRA_ALLOWED=

# --- Worker / execution limits ---
MAX_CONCURRENT_TASKS=2
MAX_CONCURRENT_WORKFLOWS=2
TASK_TIMEOUT_MS=2700000
ANALYSIS_TIMEOUT_MS=1200000
DEFAULT_MAX_TURNS=150
MAX_MAX_TURNS=400
WORKSPACE_RETENTION_MINUTES=240

# --- Storage (mount a Railway volume at /data on the worker) ---
# WORKSPACE_ROOT=/data/workspaces
# CLAUDE_HOME_DIR=/data/claude-home

# --- Registry bootstrap (optional; the `repos` CLI is the alternative) ---
# REPOSITORIES_FILE=./repositories.json
# WORKFLOWS_FILE=./workflows.json

# --- Git identity used for bridge-created commits ---
GIT_USER_NAME=Operava Claude Bridge
GIT_USER_EMAIL=claude-bridge[bot]@users.noreply.github.com
