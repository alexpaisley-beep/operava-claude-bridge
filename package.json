{
  "name": "operava-claude-bridge",
  "version": "1.0.0",
  "description": "Remote MCP server that lets ChatGPT delegate durable engineering work to Claude Code against allowlisted GitHub repositories.",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "migrate": "node dist/cli/migrate.js",
    "dev:migrate": "tsx src/cli/migrate.ts",
    "dev:api": "tsx watch src/api/main.ts",
    "dev:worker": "tsx watch src/worker/main.ts",
    "dev": "bash scripts/dev.sh",
    "seed": "tsx src/cli/seed.ts",
    "repos": "tsx src/cli/repo-admin.ts",
    "start:api": "node dist/api/main.js",
    "start:worker": "node dist/worker/main.js"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.237",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@octokit/request-error": "^7.1.1",
    "@octokit/rest": "^22.0.1",
    "express": "^5.2.1",
    "pg": "^8.23.0",
    "pino": "^10.3.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@types/express": "^5.0.6",
    "@types/node": "^22.18.0",
    "@types/pg": "^8.15.5",
    "eslint": "^9.39.0",
    "tsx": "^4.23.12",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.67.0",
    "vitest": "^4.1.11"
  }
}
